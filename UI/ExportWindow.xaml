<Window x:Class="ClearView.UI.ExportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="3D HTML Viewer — Export Package"
        Height="640" Width="560"
        WindowStartupLocation="CenterScreen"
        Background="#FFFFFF"
        Foreground="#1A1A1A"
        ResizeMode="CanResizeWithGrip"
        FontFamily="Segoe UI">
  <Window.Resources>
    <Style TargetType="TextBlock">
      <Setter Property="Foreground" Value="#1A1A1A"/>
    </Style>
    <Style TargetType="CheckBox">
      <Setter Property="Foreground" Value="#1A1A1A"/>
      <Setter Property="Margin" Value="0,4,0,0"/>
    </Style>
    <Style TargetType="Button">
      <Setter Property="Padding" Value="14,8"/>
      <Setter Property="Margin" Value="0,0,8,0"/>
      <Setter Property="Background" Value="#1A1A1A"/>
      <Setter Property="Foreground" Value="#FFFFFF"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style TargetType="TextBox">
      <Setter Property="Background" Value="#FFFFFF"/>
      <Setter Property="Foreground" Value="#1A1A1A"/>
      <Setter Property="BorderBrush" Value="#CCCCCC"/>
      <Setter Property="Padding" Value="6,4"/>
    </Style>
  </Window.Resources>

  <Grid Margin="20">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <StackPanel Grid.Row="0" Margin="0,0,0,12">
      <TextBlock Text="3D HTML Viewer" FontSize="11" Foreground="#666666" FontFamily="Consolas"/>
      <TextBlock Text="Export 3D Package" FontSize="22" FontWeight="SemiBold" Margin="0,4,0,0"/>
      <TextBlock x:Name="ViewLabel" FontSize="13" Foreground="#666666" Margin="0,4,0,0"
                 Text="Current 3D view only"/>
    </StackPanel>

    <Grid Grid.Row="1" Margin="0,0,0,12">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="12"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>
      <StackPanel Grid.Column="0">
        <TextBlock Text="Brand label" FontSize="11" Foreground="#666666"/>
        <TextBox x:Name="BrandBox" Height="32" Margin="0,4,0,0"/>
      </StackPanel>
      <StackPanel Grid.Column="2">
        <TextBlock Text="Output HTML path" FontSize="11" Foreground="#666666"/>
        <DockPanel Margin="0,4,0,0">
          <Button DockPanel.Dock="Right" Content="…" Width="36" Click="Browse_Click"
                  Background="#F0F0F0" Foreground="#1A1A1A" BorderBrush="#CCCCCC" BorderThickness="1"/>
          <TextBox x:Name="PathBox" Height="32" Margin="0,0,6,0"/>
        </DockPanel>
      </StackPanel>
    </Grid>

    <Grid Grid.Row="2">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="12"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>
      <DockPanel Grid.Column="0">
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
          <TextBlock Text="LEVELS" FontSize="11" Foreground="#666666" FontFamily="Consolas"/>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="All" Click="LevelsAll_Click" Background="Transparent" Foreground="#666666" Padding="6,2"/>
            <Button Content="None" Click="LevelsNone_Click" Background="Transparent" Foreground="#666666" Padding="6,2"/>
          </StackPanel>
        </DockPanel>
        <ScrollViewer VerticalScrollBarVisibility="Auto" Background="#F7F7F7" Padding="8" BorderBrush="#E0E0E0" BorderThickness="1">
          <StackPanel x:Name="LevelsPanel"/>
        </ScrollViewer>
      </DockPanel>
      <DockPanel Grid.Column="2">
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
          <TextBlock Text="CATEGORIES" FontSize="11" Foreground="#666666" FontFamily="Consolas"/>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="All" Click="CatsAll_Click" Background="Transparent" Foreground="#666666" Padding="6,2"/>
            <Button Content="None" Click="CatsNone_Click" Background="Transparent" Foreground="#666666" Padding="6,2"/>
          </StackPanel>
        </DockPanel>
        <ScrollViewer VerticalScrollBarVisibility="Auto" Background="#F7F7F7" Padding="8" BorderBrush="#E0E0E0" BorderThickness="1">
          <StackPanel x:Name="CategoriesPanel"/>
        </ScrollViewer>
      </DockPanel>
    </Grid>

    <StackPanel Grid.Row="3" Margin="0,14,0,0">
      <DockPanel>
        <TextBlock Text="Tessellation" FontSize="11" Foreground="#666666"/>
        <TextBlock x:Name="TessLabel" HorizontalAlignment="Right" FontSize="11" Foreground="#666666" FontFamily="Consolas"/>
      </DockPanel>
      <Slider x:Name="TessSlider" Minimum="2" Maximum="16" Value="13" TickFrequency="1" IsSnapToTickEnabled="True"
              Margin="0,6,0,0" ValueChanged="TessSlider_ValueChanged"/>
      <CheckBox x:Name="ColorsCheck" Content="Use Revit material / category colours" IsChecked="True" Margin="0,10,0,0"/>
      <CheckBox x:Name="LinksCheck" Content="Include linked models" IsChecked="False" Margin="0,4,0,0"/>
      <CheckBox x:Name="MergeCheck" Content="Merge meshes (OFF = select single elements; ON = faster/larger groups)" IsChecked="False" Margin="0,4,0,0"/>
      <CheckBox x:Name="ToolsCheck" Content="Enable Measure + Section cut + Select tools in HTML" IsChecked="True" Margin="0,4,0,0"/>
      <Button x:Name="SystemColorsBtn" Content="System colours…" Click="SystemColors_Click"
              HorizontalAlignment="Left" Margin="0,10,0,0"
              Background="#F0F0F0" Foreground="#1A1A1A" BorderBrush="#CCCCCC" BorderThickness="1"
              ToolTip="Choose a colour for each MEP system classification before export"/>
      <DockPanel Margin="0,8,0,0">
        <TextBlock Text="Skip elements smaller than (ft)" FontSize="11" Foreground="#666666" VerticalAlignment="Center"/>
        <TextBox x:Name="MinSizeBox" Width="64" Height="28" HorizontalAlignment="Right" Text="0.001"/>
      </DockPanel>
    </StackPanel>

    <DockPanel Grid.Row="4" Margin="0,18,0,0" LastChildFill="False" HorizontalAlignment="Right">
      <Button Content="Cancel" Click="Cancel_Click" Background="#F0F0F0" Foreground="#1A1A1A" BorderBrush="#CCCCCC" BorderThickness="1" IsCancel="True"/>
      <Button Content="Export package" Click="Export_Click" IsDefault="True"/>
    </DockPanel>
  </Grid>
</Window>
