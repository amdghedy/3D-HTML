<Window x:Class="ClearView.UI.SystemColorsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="System Colours — 3D HTML Viewer"
        Height="560" Width="480"
        WindowStartupLocation="CenterOwner"
        Background="#FFFFFF"
        Foreground="#1A1A1A"
        ResizeMode="CanResizeWithGrip"
        FontFamily="Segoe UI"
        MinHeight="400" MinWidth="400">
  <Window.Resources>
    <Style TargetType="TextBlock">
      <Setter Property="Foreground" Value="#1A1A1A"/>
    </Style>
    <Style TargetType="Button">
      <Setter Property="Padding" Value="14,8"/>
      <Setter Property="Margin" Value="0,0,8,0"/>
      <Setter Property="Background" Value="#1A1A1A"/>
      <Setter Property="Foreground" Value="#FFFFFF"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Cursor" Value="Hand"/>
    </Style>
  </Window.Resources>

  <Grid Margin="16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <StackPanel Grid.Row="0" Margin="0,0,0,12">
      <TextBlock Text="System Colours" FontSize="18" FontWeight="SemiBold"/>
      <TextBlock Text="Pick a colour for each MEP system classification. These colours are applied to pipes, ducts, trays and fittings that belong to that system when the package is exported."
                 FontSize="12" Foreground="#666666" TextWrapping="Wrap" Margin="0,6,0,0"/>
    </StackPanel>

    <Border Grid.Row="1" BorderBrush="#E0E0E0" BorderThickness="1" Background="#F7F7F7">
      <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="8">
        <StackPanel x:Name="RowsPanel"/>
      </ScrollViewer>
    </Border>

    <DockPanel Grid.Row="2" Margin="0,14,0,0" LastChildFill="False">
      <Button Content="Reset defaults" Click="Reset_Click"
              Background="#F0F0F0" Foreground="#1A1A1A" BorderBrush="#CCCCCC" BorderThickness="1"
              DockPanel.Dock="Left"/>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" DockPanel.Dock="Right">
        <Button Content="Cancel" Click="Cancel_Click"
                Background="#F0F0F0" Foreground="#1A1A1A" BorderBrush="#CCCCCC" BorderThickness="1" IsCancel="True"/>
        <Button Content="Apply" Click="Apply_Click" IsDefault="True"/>
      </StackPanel>
    </DockPanel>
  </Grid>
</Window>
